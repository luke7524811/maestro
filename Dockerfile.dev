# Maestro Web - Development Dockerfile
# Includes hot reload and dev tools

FROM node:20-alpine

# Install essential tools
RUN apk add --no-cache \
    bash \
    git \
    curl \
    python3 \
    make \
    g++ \
    openssh-client

WORKDIR /app

# Install server dependencies
COPY server/package*.json ./server/
RUN cd server && npm ci

# Install web dependencies
COPY web/package*.json ./web/
RUN cd web && npm ci

# Copy source files
COPY server ./server
COPY web ./web

# Expose ports
EXPOSE 3100 3000

# Development command - run both server and frontend
CMD cd /app/server && npm run dev & cd /app/web && npm run dev -- --host 0.0.0.0
