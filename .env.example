# Maestro Web Configuration
# Copy this file to .env and customize for your system

# =============================================================================
# CROSS-PLATFORM HOST FILESYSTEM ACCESS
# =============================================================================
# Path on your host machine to mount inside the container at /host
# This allows Maestro sessions to access your local files
#
# Linux examples:
#   HOST_MOUNT_PATH=/home/username
#   HOST_MOUNT_PATH=/                    # Full filesystem (use with caution)
#
# macOS examples:
#   HOST_MOUNT_PATH=/Users/username
#   HOST_MOUNT_PATH=/Users/username/Projects
#
# Windows examples (Docker Desktop):
#   HOST_MOUNT_PATH=C:/Users/username    # Use forward slashes
#   HOST_MOUNT_PATH=C:/Projects
#
# Leave empty to disable host filesystem mounting (only workspace available)
HOST_MOUNT_PATH=

# =============================================================================
# SSH KEYS (Optional - for git operations)
# =============================================================================
# Path to your SSH keys directory
#
# Linux:   SSH_KEYS_PATH=/home/username/.ssh
# macOS:   SSH_KEYS_PATH=/Users/username/.ssh
# Windows: SSH_KEYS_PATH=C:/Users/username/.ssh
#
# Leave empty to disable SSH key mounting
SSH_KEYS_PATH=

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port to expose Maestro Web UI
PORT=3100

# Number of sessions to create on startup (0 = none, create manually)
DEFAULT_SESSIONS=0

# Default project/workspace path inside container
PROJECT_PATH=/workspace

# =============================================================================
# API KEYS (Optional - can also authenticate interactively in sessions)
# =============================================================================
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# GEMINI_API_KEY=your-gemini-key-here
# OPENAI_API_KEY=sk-your-openai-key-here

# =============================================================================
# ADVANCED OPTIONS
# =============================================================================
# GitHub token for git operations (optional)
# GITHUB_TOKEN=ghp_your-token-here

# Custom CLI paths (if installed in non-standard locations)
# CLAUDE_PATH=/usr/local/bin/claude
# GEMINI_PATH=/usr/local/bin/gemini
# CODEX_PATH=/usr/local/bin/codex
