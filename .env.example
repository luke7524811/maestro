# Maestro Web Configuration
# Copy this file to .env and customize as needed

# Server Configuration
NODE_ENV=production
PORT=3100
DEFAULT_SESSIONS=0
PROJECT_PATH=/workspace

# Optional: AI CLI API Keys (Alternative to interactive authentication)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# GEMINI_API_KEY=your-gemini-key-here
# OPENAI_API_KEY=sk-your-openai-key-here

# Optional: GitHub integration (for git operations)
# GITHUB_TOKEN=ghp_your-token-here

# Optional: Custom CLI paths (if installed in non-standard locations)
# CLAUDE_PATH=/usr/local/bin/claude
# GEMINI_PATH=/usr/local/bin/gemini
# CODEX_PATH=/usr/local/bin/codex